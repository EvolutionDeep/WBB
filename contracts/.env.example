# Deployer private key -- fill into local .env through a secure channel only.
# NEVER commit .env and NEVER paste the key into chat or logs.
DEPLOYER_PRIVATE_KEY=

# Optional: custom BSC RPC (defaults to the public dataseed endpoint)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Optional: used for automated contract source verification on BscScan
BSCSCAN_API_KEY=

# Filled in after deployment, used by the off-chain simulation nodes
GENOME_ADDRESS=
HEARTBEAT_ADDRESS=
